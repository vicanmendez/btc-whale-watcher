# =============================================================================
# BTC Whale Intelligence - plantilla de configuración
# Copiar a `.env` y completar. `.env` NUNCA debe versionarse (Principio XII).
# =============================================================================

# --- Persistencia -------------------------------------------------------------
DATABASE_URL=sqlite:///datos/ballenas.db

# --- Logs ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/whalewatcher.log
LOG_MAX_BYTES=10485760
LOG_BACKUPS=5

# --- Fuente on-chain (API Esplora) -------------------------------------------
MEMPOOL_API_URL=https://mempool.space/api
# Respaldo automático si la fuente principal falla. Vacío = sin respaldo.
ESPLORA_FALLBACK_URL=https://blockstream.info/api
# Intervalo mínimo entre peticiones a la misma API (segundos) para respetar cuotas.
ONCHAIN_INTERVALO_MIN_SEG=0.5
# Escanear bloques completos (necesario para detectar ballenas desconocidas).
ESCANEAR_BLOQUES_COMPLETOS=true
MAX_BLOQUES_POR_CICLO=3
MAX_DIRECCIONES_POR_CICLO=25
# Vigilar el mempool de las direcciones catalogadas.
VIGILAR_MEMPOOL_DIRECCIONES=true

# --- Fuente de mercado (Binance Public Market Data) ---------------------------
# data-api.binance.vision sirve solo datos públicos de mercado, sin clave.
# Alternativas sin cambiar código: https://api.binance.com/api/v3 o
# https://api.binance.us/api/v3 (si api.binance.com devuelve HTTP 451 por región).
BINANCE_API_URL=https://data-api.binance.vision/api/v3
PAR_MERCADO=BTCUSDT
MERCADO_INTERVALO_MIN_SEG=0.2
# Tolerancia máxima (minutos) para asociar un precio a un instante.
TOLERANCIA_PRECIO_MIN=5

# --- Umbrales de relevancia (BTC) --------------------------------------------
UMBRAL_EXCHANGE_BTC=500
UMBRAL_INSTITUCIONAL_BTC=250
UMBRAL_DESCONOCIDO_BTC=1000
# Certeza mínima de una atribución para usarla en la clasificación (0-1).
CERTEZA_MINIMA_ATRIBUCION=0.7

# --- Análisis de impacto ------------------------------------------------------
# Umbral (|rentabilidad| en %) por debajo del cual un movimiento es NEUTRAL.
UMBRAL_NEUTRAL_24H_PCT=1.0
UMBRAL_NEUTRAL_7D_PCT=3.0
UMBRAL_NEUTRAL_30D_PCT=6.0
# Modelo predictivo para producción. "indeterminado" = sin estimaciones (v1).
# Cualquier otro modelo solo se usa si existe una validación fuera de muestra aprobada.
MODELO_PREDICTIVO=indeterminado
MUESTRA_MINIMA_ASOCIACION=30
# Backtesting
FRACCION_RESERVA_FINAL=0.2
MUESTRA_MINIMA_VALIDACION=100
# Días de gracia para obtener el precio final antes de marcar SIN_DATOS.
DIAS_GRACIA_EVALUACION=3

# --- Correo SMTP --------------------------------------------------------------
ALERTAS_HABILITADAS=true
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=usuario@ejemplo.com
SMTP_PASSWORD=
SMTP_FROM=usuario@ejemplo.com
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SEG=20
# Varios destinatarios separados por comas.
ALERT_EMAIL_TO=destinatario@ejemplo.com
MAX_INTENTOS_ALERTA=5
EXPLORADOR_TX_URL=https://mempool.space/tx/

[Unit]
Description=BTC Whale Intelligence - Temporizador de Monitoreo Periódico (cada 5 minutos)
After=network.target

[Timer]
# Ejecuta 2 minutos tras el arranque del sistema y cada 5 minutos después
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
